{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tyndale:collections:payer_policies",
  "title": "Tyndale payer_policies record",
  "description": "A payer medical-necessity / coverage policy chunk (CMS LCD/NCD or commercial). Point-in-time filtered by date-of-service.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chunk_id",
    "payer",
    "policy_id",
    "version",
    "effective_date_start",
    "effective_date_end",
    "plan_type",
    "chunk_text",
    "last_verified_date"
  ],
  "properties": {
    "chunk_id": { "type": "string" },
    "payer": { "type": "string" },
    "policy_id": { "type": "string", "description": "Payer's internal policy identifier." },
    "version": { "type": "string" },
    "effective_date_start": { "type": "string", "format": "date" },
    "effective_date_end": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Null for current policy."
    },
    "applicable_codes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "plan_type": {
      "type": "string",
      "enum": ["commercial", "Medicare", "Medicaid"]
    },
    "chunk_text": {
      "type": "string",
      "description": "The embedded text (synthesized fixture; not verbatim proprietary policy)."
    },
    "last_verified_date": { "type": "string", "format": "date" }
  },
  "examples": [
    {
      "chunk_id": "mcr_lcd_mri_knee_001",
      "payer": "Medicare",
      "policy_id": "LCD-FIXTURE-0001",
      "version": "R3",
      "effective_date_start": "2023-07-01",
      "effective_date_end": null,
      "applicable_codes": ["73721"],
      "plan_type": "Medicare",
      "chunk_text": "MRI of the knee without contrast is considered medically necessary when conservative therapy has failed and internal derangement is suspected (e.g., persistent locking, instability, or a suspected meniscal or ligamentous tear). Routine imaging for uncomplicated, self-limited knee pain is not covered.",
      "last_verified_date": "2026-01-15"
    }
  ]
}
