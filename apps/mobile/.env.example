# Local dev: http://localhost:4000 (runtime running locally).
# Deployed dev: https://api.tyndaleapp.net (the public runtime API).
# EXPO_PUBLIC_* is baked at build time — set the real value in .env (gitignored)
# or your EAS build profile, not just at runtime.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
# Plausible removed (Internal Analytics P0): the authenticated app no longer sends
# analytics to a third party. Funnel truth is captured server-side in analytics_events.
# Google OAuth client IDs are per-platform for Expo — fill in Phase 2
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Legal publication gate. Leave false/unset until counsel signs off: the Terms &
# Privacy screens then show the real copy under a "DRAFT — under attorney review"
# banner with bracketed fill-in fields. Set to "true" (and fill LEGAL_FIELDS in
# packages/shared/src/legal.ts) to publish — that flip removes the banner.
EXPO_PUBLIC_LEGAL_PUBLISHED=false
