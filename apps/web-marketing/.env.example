NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=tyndaleapp.net
NEXT_PUBLIC_PLAUSIBLE_SCRIPT=https://plausible.io/js/script.js
# Legal publication gate. Leave false/unset until counsel signs off: the /terms
# and /privacy pages then show the real copy under a "DRAFT — under attorney
# review" banner with bracketed fill-in fields. Set to "true" (and fill
# LEGAL_FIELDS in packages/shared/src/legal.ts) to publish — that flip removes
# the banner.
NEXT_PUBLIC_LEGAL_PUBLISHED=false
AUTH_URL=http://localhost:3000
AUTH_SECRET=                     # openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
