# Copy to terraform.tfvars (gitignored) and fill in real values.
# terraform.tfvars is gitignored so secrets stay off the repo, but the file
# still sits on your laptop in plaintext — treat it accordingly.

azure_subscription_id   = "00000000-0000-0000-0000-000000000000"
azure_tenant_id         = "00000000-0000-0000-0000-000000000000"

# Postgres admin password. Azure requires 8-128 chars with characters from 3
# of: uppercase, lowercase, numbers, non-alphanumeric; cannot contain the
# admin username (default "tyndale_admin"). Alternative to writing it here:
# export TF_VAR_postgres_admin_password='...' before terraform apply.
postgres_admin_password = "REPLACE_WITH_STRONG_PASSWORD"

# --- Application secrets ----------------------------------------------------
# Stored in Key Vault on apply; consumed by the runtime Container App (env
# vars via KV references) and the marketing SWA (app settings).
anthropic_api_key          = "sk-ant-REPLACE_ME"
voyage_api_key             = "pa-REPLACE_ME"
google_oauth_client_id     = "REPLACE_ME.apps.googleusercontent.com"
google_oauth_client_secret = "GOCSPX-REPLACE_ME"

# Real-Claude toggle. false (default) = runtime serves deterministic fixtures
# (zero API cost — what you get if this line is omitted). true = chat + audits
# call the real Anthropic API directly, using the anthropic_api_key above, which
# must be a real "sk-…" key or the runtime SILENTLY falls back to fixtures.
# Costs money per request. Set in terraform.tfvars (not just here) and apply.
use_real_claude = true

# --- Auth + email -----------------------------------------------------------
# NOTE: there is intentionally NO auth_secret here. The runtime's JWT signing
# key (env AUTH_SECRET) has no external counterpart, so Terraform auto-
# generates it (random_password.auth_secret in secrets.tf) and stores it in
# Key Vault. You never set it by hand.
#
# SendGrid magic-link email (Email API Pro tier under a BAA, per DL-18).
# OPTIONAL: leave sendgrid_api_key empty ("") and the runtime LOGS the sign-in
# link instead of emailing it — the KV secret + env wiring are skipped, so
# apply works fine before you have a SendGrid account. Set the "SG.…" value to
# send real email; sendgrid_from_email must be a verified SendGrid sender.
sendgrid_api_key    = "" # e.g. "SG.xxxxxxxxxxxx" to enable real email
sendgrid_from_email = "no-reply@tyndaleapp.net"

# Real-auth toggle. false (default) = runtime keeps the seeded-admin stub, no
# sign-in needed. true = require real Google / magic-link auth; also needs the
# runtime reachable from the browser (ingress + CORS) and the Google redirect
# URI registered. Flip on a follow-up apply once those are in place.
use_real_auth = false

# Flip to true on a follow-up apply, after DNS records propagate publicly
# (see variables.tf).
# enable_marketing_custom_domain = true
# enable_marketing_managed_cert  = true

# Public runtime API at api.tyndaleapp.net — required for real Google/magic-link
# auth (the session cookie needs an HTTPS .tyndaleapp.net host). Phased apply:
#   1) leave both false   -> runtime goes public on its raw FQDN; api CNAME lands
#   2) enable_runtime_custom_domain = true  (after api.tyndaleapp.net resolves)
#   3) enable_runtime_managed_cert  = true  (binds the managed TLS cert)
# enable_runtime_custom_domain = true
# enable_runtime_managed_cert  = true

# Public product app at app.tyndaleapp.net (Expo static web export). Same phased
# apply as the others:
#   1) leave both false   -> app goes public on its raw FQDN; app CNAME lands
#   2) enable_app_custom_domain = true  (after app.tyndaleapp.net resolves)
#   3) enable_app_managed_cert  = true  (binds the managed TLS cert)
# enable_app_custom_domain = true
# enable_app_managed_cert  = true

# --- Phase CO-6A admin console (admin.tyndaleapp.net) -----------------------
# ████ FLAG FOR BROCK — REQUIRED BEFORE APPLY ████
# The admin console uses a NETWORK-layer IP allowlist (DL-60). The default in
# variables.tf is a TEST-NET placeholder (203.0.113.0/24) that blocks ALL real
# traffic — INCLUDING BROCK'S. Set Brock's real CIDRs here BEFORE `terraform
# apply`, or the admin console is unreachable by everyone. Use /32 for single
# IPs (e.g. "198.51.100.23/32"); include home/office + a VPN/travel fallback.
# admin_allowed_ip_ranges = ["198.51.100.23/32", "203.0.113.10/32"]
#
# Phased custom-domain + cert apply (same as the others):
#   1) leave both false   -> admin goes public on its raw FQDN; admin CNAME lands
#   2) enable_admin_custom_domain = true  (after admin.tyndaleapp.net resolves)
#   3) enable_admin_managed_cert  = true  (binds the managed TLS cert)
# enable_admin_custom_domain = true
# enable_admin_managed_cert  = true
