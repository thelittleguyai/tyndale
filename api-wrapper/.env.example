# Which 1upHealth environment this process targets: "sandbox" or "production".
# Only affects which credentials are used by default and is surfaced in logs/errors.
ONEUP_ENVIRONMENT=sandbox

# App credentials issued by 1upHealth. Keep the real values out of source control.
ONEUP_CLIENT_ID=your_1up_client_id
ONEUP_CLIENT_SECRET=your_1up_client_secret

# Where the payer OAuth flow (Setup Call 4) redirects back to after the patient
# authorizes. Must be registered with 1up.
ONEUP_REDIRECT_URI=https://tyndale.app/callback

# FHIR scope requested during payer OAuth. Read-only by default.
ONEUP_SCOPE=user/*.read

# --- Optional base-URL overrides ---
# Leave unset to use the documented 1up defaults. Override only if 1up gives you
# a different host (e.g. a dedicated sandbox host).
# ONEUP_BASE_USER_MANAGEMENT=https://api.1up.health
# ONEUP_BASE_AUTH=https://auth.1up.health
# ONEUP_BASE_SYSTEM_SEARCH=https://system-search.1up.health

# --- HTTP service (src/server.ts) ---
# Port the service listens on. In dev/containers this is fronted by the
# Container App ingress on :80.
PORT=8088

# Master gate. Mirrors the runtime's ENABLE_COVERAGE_CONNECTION flag: when not
# "true", data routes return 503 and the runtime never calls this service.
ENABLE_COVERAGE_CONNECTION=false

# Shared bearer secret the runtime must send on every data request. In dev this
# is a Key Vault secret held by both this service and the runtime. Generate a
# random value locally; never commit the real one.
WRAPPER_AUTH_TOKEN=local_dev_only_change_me
