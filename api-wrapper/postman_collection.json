          "path": [
            "v1",
            "financial-picture"
          ],
          "query": [
            {
              "key": "app_user_id",
              "value": "{{app_user_id}}",
              "description": "REQUIRED"
            },
            {
              "key": "since",
              "value": "2026-01-01",
              "description": "OPTIONAL \u2014 applies to the claims fan-out"
            }
          ]
        },
        "description": "One call, all four families: {coverages, claims, accumulators, encounters}. Prefer the individual routes when you need one family (the fan-out triggers redundant upstream FHIR reads). NOTE: encounters is always [] today \u2014 no clinical adapter is wired into buildSources(); the key exists for shape stability. Accumulators inside the fan-out follow the same rules as the /v1/accumulators route: one computed-from-eob reading, met amounts only."
      },
