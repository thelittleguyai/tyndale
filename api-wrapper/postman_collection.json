{
  "info": {
    "name": "Tyndale \u2014 1upHealth Wrapper Service",
    "description": "The wrapper's four data routes + health. Deployed instance is INTERNAL-ONLY \u2014 point base_url at a local run (see api-wrapper/API.md for env setup). All data routes: GET only, Bearer auth, app_user_id required. Every value comes wrapped in a SourceResult envelope (value / provenance / freshness / confidence).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{wrapper_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8088",
      "description": "Local run of the wrapper. Deployed instance is internal-ingress only."
    },
    {
      "key": "wrapper_token",
      "value": "dev-local-token",
      "description": "Must equal the service's WRAPPER_AUTH_TOKEN env. Deployed value: Key Vault secret WRAPPER-AUTH-TOKEN."
    },
    {
      "key": "app_user_id",
      "value": "REPLACE-with-case-or-user-uuid",
      "description": "Passthrough id today (D2 identity mapping pending)."
    }
  ],
  "item": [
    {
      "name": "Health (unauthenticated)",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Liveness + the two gate booleans. enabled = ENABLE_COVERAGE_CONNECTION; configured = 1up credentials present."
      },
      "response": [
        {
          "name": "200 \u2014 gated off (current dev posture)",
          "originalRequest": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "content-type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"status\": \"ok\",\n  \"enabled\": false,\n  \"configured\": false\n}"
        }
      ]
    },
    {
      "name": "Coverages",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/v1/coverages?app_user_id={{app_user_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "coverages"
          ],
          "query": [
            {
              "key": "app_user_id",
              "value": "{{app_user_id}}",
              "description": "REQUIRED"
            }
          ]
        },
        "description": "Coverage plans as SourceResult<CoveragePlan>[]. Money in dollars + ISO currency."
      },
      "response": [
        {
          "name": "200 \u2014 one active plan",
          "originalRequest": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/coverages?app_user_id={{app_user_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "coverages"
              ],
              "query": [
                {
                  "key": "app_user_id",
                  "value": "{{app_user_id}}"
                }
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "content-type",
              "value": "application/json"
            }
          ],
          "body": "[\n  {\n    \"value\": {\n      \"payerName\": \"Blue Shield\",\n      \"memberId\": \"XEG123456789\",\n      \"groupNumber\": \"GRP-4417\",\n      \"planType\": \"PPO\",\n      \"status\": \"active\",\n      \"coverageStart\": \"2026-01-01\"\n    },\n    \"provenance\": {\n      \"vendor\": \"1upHealth\",\n      \"method\": \"fhir-read\",\n      \"sourceRefs\": [\"Coverage/abc123\"],\n      \"retrievedAt\": \"2026-08-13T17:20:11Z\"\n    },\n    \"freshness\": { \"asOf\": \"2026-08-13T17:20:11Z\", \"ageDays\": 0 },\n    \"confidence\": { \"level\": \"high\", \"reasons\": [] }\n  }\n]"
        },
        {
          "name": "424 \u2014 no connected payer",
          "originalRequest": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/coverages?app_user_id={{app_user_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "coverages"
              ],
              "query": [
                {
                  "key": "app_user_id",
                  "value": "{{app_user_id}}"
                }
              ]
            }
          },
          "status": "Failed Dependency",
          "code": 424,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "content-type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"error\": \"missing_tokens\",\n  \"message\": \"No payer tokens for app_user \u2026\"\n}"
