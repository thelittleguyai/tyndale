    },
    {
      "name": "Claims",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/v1/claims?app_user_id={{app_user_id}}&since=2026-01-01",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "claims"
          ],
          "query": [
            {
              "key": "app_user_id",
              "value": "{{app_user_id}}",
              "description": "REQUIRED"
            },
            {
              "key": "since",
              "value": "2026-01-01",
              "description": "OPTIONAL \u2014 service date on/after this ISO date"
            }
          ]
        },
        "description": "Adjudicated claims as SourceResult<ClaimRecord>[] with per-line CPT/billed/allowed/paid/patientResponsibility."
      },
      "response": [
        {
          "name": "200 \u2014 one claim, one line",
