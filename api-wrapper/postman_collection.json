          ],
          "body": "[\n  {\n    \"value\": {\n      \"claimId\": \"EOB-889123\",\n      \"serviceStart\": \"2026-04-02\",\n      \"serviceEnd\": \"2026-04-02\",\n      \"provider\": \"Maple Grove Family Medicine\",\n      \"billed\": { \"amount\": 374.0, \"currency\": \"USD\" },\n      \"allowed\": { \"amount\": 254.5, \"currency\": \"USD\" },\n      \"insurerPaid\": { \"amount\": 226.1, \"currency\": \"USD\" },\n      \"patientResponsibility\": { \"amount\": 28.4, \"currency\": \"USD\" },\n      \"adjudicationStatus\": \"complete\",\n      \"lines\": [\n        {\n          \"cptCode\": \"99214\",\n          \"description\": \"Office visit, established\",\n          \"billed\": { \"amount\": 240.0, \"currency\": \"USD\" },\n          \"allowed\": { \"amount\": 142.0, \"currency\": \"USD\" },\n          \"insurerPaid\": { \"amount\": 113.6, \"currency\": \"USD\" },\n          \"patientResponsibility\": { \"amount\": 28.4, \"currency\": \"USD\" }\n        }\n      ]\n    },\n    \"provenance\": { \"vendor\": \"1upHealth\", \"method\": \"fhir-read\", \"sourceRefs\": [\"ExplanationOfBenefit/889123\"], \"retrievedAt\": \"2026-08-13T17:20:11Z\" },\n    \"freshness\": { \"asOf\": \"2026-04-02\", \"ageDays\": 133 },\n    \"confidence\": { \"level\": \"high\", \"reasons\": [] }\n  }\n]"
        }
      ]
    },
    {
      "name": "Accumulators",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/v1/accumulators?app_user_id={{app_user_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "accumulators"
          ],
          "query": [
            {
              "key": "app_user_id",
              "value": "{{app_user_id}}",
              "description": "REQUIRED"
            }
          ]
        },
        "description": "Deductible/OOP positions as SourceResult<AccumulatorSnapshot>[]. TODAY: exactly one computed-from-eob reading per user, carrying ONLY met amounts on individualDeductible/individualOopMax (plan limits are not derivable from EOBs \u2014 no limit/remaining/plan-year fields; keys omitted when the sum is zero). Confidence is capped at medium with fixed reasons. The array shape reserves room for a future eligibility-backed second reading with disagreement preserved (reconciliation is the runtime's job) \u2014 not emitted yet."
      },
      "response": [
        {
          "name": "200 \u2014 computed-from-EOB reading",
          "originalRequest": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/v1/accumulators?app_user_id={{app_user_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "accumulators"
              ],
              "query": [
                {
                  "key": "app_user_id",
                  "value": "{{app_user_id}}"
                }
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "content-type",
              "value": "application/json"
            }
          ],
          "body": "[\n  {\n    \"value\": {\n      \"individualDeductible\": {\n        \"met\": {\n          \"amount\": 1750,\n          \"currency\": \"USD\"\n        }\n      },\n      \"individualOopMax\": {\n        \"met\": {\n          \"amount\": 3200,\n          \"currency\": \"USD\"\n        }\n      }\n    },\n    \"provenance\": {\n      \"vendor\": \"1upHealth\",\n      \"method\": \"computed-from-eob\",\n      \"sourceRefs\": [\n        \"ExplanationOfBenefit/889123\"\n      ],\n      \"retrievedAt\": \"2026-08-13T17:20:11Z\"\n    },\n    \"freshness\": {\n      \"asOf\": \"2026-08-13T17:20:11Z\",\n      \"ageDays\": 0\n    },\n    \"confidence\": {\n      \"level\": \"medium\",\n      \"reasons\": [\n        \"reconstructed by summing EOB adjudications\",\n        \"plan limits not derivable from EOBs alone\"\n      ]\n    }\n  }\n]"
        }
      ]
    },
    {
      "name": "Financial picture (combined fan-out)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/v1/financial-picture?app_user_id={{app_user_id}}&since=2026-01-01",
